# AdvisorAssist Environment Configuration
# Copy this file to .env and add your API keys

# ============================================================
# REQUIRED: OpenAI API Key
# ============================================================
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...


# ============================================================
# OPTIONAL: Search API Keys (Highly Recommended)
# ============================================================
# Search enrichment dramatically improves report quality with
# real-time market data, competitive intelligence, and trends

# Perplexity AI (Recommended for restaurant research)
# Get your key from: https://docs.perplexity.ai/guides/getting-started
PERPLEXITY_API_KEY=pplx-...

# SerpAPI (Alternative Google Search)
# Get your key from: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=...
# Alternate variable name (both work):
# SERPAPI_KEY=...


# ============================================================
# OPTIONAL: Model Configuration
# ============================================================
# Uncomment to override defaults

# Default model (gpt-4o recommended for quality)
# OPENAI_MODEL=gpt-4o

# Temperature (0.1-0.9, default 0.3)
# Lower = more deterministic, Higher = more creative
# OPENAI_TEMPERATURE=0.3

# Maximum tokens for responses
# OPENAI_MAX_TOKENS=4096


# ============================================================
# OPTIONAL: Cache Configuration
# ============================================================
# Cache TTL in seconds (default: 86400 = 24 hours)
# CACHE_TTL=86400

# Semantic cache similarity threshold (0.0-1.0, default: 0.92)
# Higher = stricter matching, Lower = more cache hits
# SEMANTIC_CACHE_THRESHOLD=0.92


# ============================================================
# OPTIONAL: Output Configuration
# ============================================================
# Directory for generated reports
# OUTPUTS_DIR=outputs

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO


# ============================================================
# Notes
# ============================================================
# 1. NEVER commit this file to version control with real API keys
# 2. Keep your API keys secure and rotate them regularly
# 3. Search API keys are optional but highly recommended for:
#    - Market research reports
#    - Competitive analysis
#    - Industry trend analysis
#    - Pricing benchmarking
# 4. Without search keys, reports will use only AI knowledge
#    (still high quality but without real-time data)